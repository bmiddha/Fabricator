# Leave FABRICATOR_SKIP_JAVA_CHECK disabled in production.
FABRICATOR_SKIP_JAVA_CHECK=0

# Network binding. Default is loopback-only.
# Set HOST=0.0.0.0 only when running behind a trusted reverse proxy.
HOST=127.0.0.1
PORT=5000

# Release source defaults to this fork. main is active development; self-update
# installs published panel releases, not Git pulls. Native installs persist these
# settings in root-owned /etc/fabricator/source.env via tools/install.sh.
# FABRICATOR_REPO=bmiddha/Fabricator
# FABRICATOR_BRANCH=main

# CORS allowlist. Must be a comma-separated list of concrete origins.
# Wildcard '*' is rejected to prevent CSRF against destructive endpoints.
CORS_ORIGINS=http://localhost:3000

# Operational alerts: configured in Settings > Alerts & notifications.
# The public URL supplies absolute links, never authentication credentials.
# Delivery and disk sampling run in a restart-safe background worker.
# FABRICATOR_PUBLIC_URL=https://panel.example
# FABRICATOR_DISABLE_NOTIFICATIONS=0
# Private destinations require an operator-owned exact origin/IP mapping.
# Default: public HTTPS on port 443 only. Never allow an internal admin service.
# FABRICATOR_WEBHOOK_PRIVATE_TARGETS='{"https://hooks.internal:8443":["10.20.30.40"]}'
# See deploy/notifications/README.md for permissions, retention and threat model.

# Max size (bytes) of an uploaded world archive for the Backups → Import world
# feature. Enforced while streaming so an oversize upload never lands fully on
# disk. Default 10 GiB. If you front Fabricator with a reverse proxy, also raise
# its body limit (e.g. nginx `client_max_body_size`) or it will cap large worlds
# before Flask sees them.
# FABRICATOR_MAX_WORLD_UPLOAD_BYTES=10737418240

# playit.gg tunnel agent. Set to "true" to launch the playit agent automatically
# on startup. When enabled, the agent exposes a public tunnel address through
# playit.gg so the server is reachable without port-forwarding.
PLAYIT_ENABLED=false

# Optional DNS state file. Defaults to dns.json next to SERVER_INDEX_FILE.
# Settings > DNS stores the private ExternalDNS-compatible webhook URL and
# allowed zone/domain. Provider secrets belong in the separate webhook service.
# Preserve this file: it contains the stable owner ID and cleanup inventory.
# FABRICATOR_DNS_FILE=/var/lib/fabricator/dns.json
# Optional custom CA and mutual-TLS credentials for a remote webhook proxy.
# FABRICATOR_DNS_CA_FILE=/run/secrets/dns-ca.pem
# FABRICATOR_DNS_CLIENT_CERT=/run/secrets/dns-client.pem
# FABRICATOR_DNS_CLIENT_KEY=/run/secrets/dns-client-key.pem
# DNS reconciliation uses the existing scheduler (every 60 seconds).
# FABRICATOR_DISABLE_SCHEDULER=1 disables automatic retries, not manual sync.
# For self-hosted PowerDNS and Cloudflare setup see deploy/dns/README.md.

# Configure python to use unbuffered logs. This allows python to stream logs to 
# stdout so they get picked up by the docker logs command when running Fabricator
# in a container.  The default value is 1, so most users will not need to change
# this when running Fabricator in Docker.

# If this variable is set to PYTHONUNBUFFERED=0, then fabricator logs will not be
# streamed to stdout. Logs will be periodically flushed to stdout, but admins
# will not be able to view the logs in real time, and any buffered logs will be lost
# if the container is stopped.
PYTHONUNBUFFERED=1

# --- Built-in panel authentication ---
# Auth is ON by default. On first boot with no credential the app starts in a
# locked SETUP MODE and serves a one-time setup page where you set the operator
# password in the browser — same on Linux, Docker and the Windows .exe, no
# terminal needed. The setup page is the default onboarding; everything below is
# the advanced / declarative override.
#
# Precedence: password = env hash > persisted file (auth.json, written by the
# setup page) > setup mode. SECRET_KEY = env > persisted file > auto-generated on
# first boot. auth.json (0600) lives next to servers.json (/var/lib/fabricator
# under systemd).
#
# Session signing key. Leave UNSET to auto-generate + persist it on first boot.
# Set it only to pin a fixed key, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# Operator password HASH (declarative override — skips the setup page).
# Recommended on untrusted networks instead of the open first-boot setup page
# (trust-on-first-use: until a password is set, whoever reaches the panel first
# can set it). Generate with:
#   fabricator hash-password          (systemd install)
#   python -m backend.auth hash       (Docker / running from source)
# FABRICATOR_AUTH_PASSWORD_HASH=
# Set to 1/true/yes to run WITHOUT the built-in login (e.g. behind your own
# reverse-proxy auth). This is the only way to disable auth. Default: enabled.
# FABRICATOR_DISABLE_AUTH=0
# Set to 1 to mark the session cookie Secure (only when TLS-terminated in front
# of Fabricator). Default off because the panel itself serves plain HTTP.
# FABRICATOR_SESSION_COOKIE_SECURE=0

# --- OIDC multi-user login (optional, deployment-owned) ---
# When configured, OIDC replaces password login/setup. All five values are
# required; invalid/partial configuration stops startup rather than opening
# access. Do not combine with FABRICATOR_DISABLE_AUTH.
# Register a confidential Authorization Code client with PKCE S256.
# HTTPS is required except for loopback development.
# FABRICATOR_OIDC_ISSUER=https://identity.example/realms/home
# FABRICATOR_OIDC_CLIENT_ID=fabricator
# FABRICATOR_OIDC_CLIENT_SECRET=
# FABRICATOR_OIDC_REDIRECT_URI=https://panel.example/api/auth/oidc/callback
# FABRICATOR_OIDC_DISPLAY_NAME=Home SSO
# HTTPS callbacks also require FABRICATOR_SESSION_COOKIE_SECURE=1.
#
# Exact, case-sensitive provider subject IDs, not emails or Minecraft names.
# Global roles apply to every current/future server. Server roles use stable
# server IDs. Assign token-user globally for self-service MCP tokens without
# granting access to every server. Unlisted subjects cannot log in.
# FABRICATOR_OIDC_USERS='{"admin-sub":{"roles":["admin"]},"user-sub":{"roles":["token-user"],"servers":{"srv_1":["operator"],"srv_2":["viewer","backup-reader"]}}}'
#
# Optional JSON role definitions. Built-ins admin/operator/viewer/token-user
# are pre-provisioned. An entry REPLACES that role, rather than extending it.
# Define arbitrary custom names using explicit permission identifiers.
# Multiple assigned roles combine additively. No wildcard/deny/inheritance.
# Server grants cannot grant global operations; any server action needs
# server.view in the effective grants. At least one user must retain all
# permissions globally. See API_DOCS.md for the complete permission catalog.
# FABRICATOR_AUTH_ROLES='{"backup-reader":["server.view","backups.list","backups.download"]}'
#
# Restart after changes: existing sessions and owned tokens use the new grants
# on their next request. Tokens created before OIDC have no owner and are
# rejected in OIDC mode; replace them through Settings > MCP.
# Logout ends only the Fabricator session, not the provider's SSO session.

# --- Managed-hosting mode (third-party operators only) ---
# Set to 1/true/yes to lock deployment-owned controls: server creation,
# RAM/JVM/java-path, playit tunnels, local backups and the self-update probe.
# Self-hosters leave this unset — the panel behaves exactly as documented above.
# Default: off.
# FABRICATOR_MANAGED=0
# When managed, every server's JVM heap is pinned to this whole-GB value; a
# managed server refuses to start if it is unset or not a positive integer.
# FABRICATOR_MANAGED_MEMORY_GB=
